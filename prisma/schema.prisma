// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            Int       @id @default(autoincrement())
  receiptNumber String    @unique
  startTime     DateTime
  finishTime    DateTime?
  status        String    @default("in_progress") // Status to indicate whether the order is in progress or completed

  unitNumber   String
  unitName     String
  customerName String
  address      String
  phoneNumber  String

  services OrderService[]
  addOns   OrderAddOn[]

  totalPayment Float?
  discount     Float?
  totalPaid    Float?
  totalItems   Int?
  totalChanges Float?
  items        OrderItem[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  itemName String
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  Int
}

model Service {
  id            Int            @id @default(autoincrement())
  serviceName   String
  serviceTypes  ServiceType[]
  orderServices OrderService[]
}

model ServiceType {
  id           Int            @id @default(autoincrement())
  service      Service        @relation(fields: [serviceId], references: [id])
  serviceId    Int
  serviceType  String // Defines the type: "small", "medium", "large"
  price        Float // Price specific to this service type
  OrderService OrderService[]
}

model AddOn {
  id          Int          @id @default(autoincrement())
  addOnName   String
  price       Float
  orderAddOns OrderAddOn[]
}

model OrderService {
  id            Int         @id @default(autoincrement())
  order         Order       @relation(fields: [orderId], references: [id])
  orderId       Int
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId Int // Refers to the specific service type (small, medium, large)
  service       Service?    @relation(fields: [serviceId], references: [id])
  serviceId     Int?
}

model OrderAddOn {
  id         Int   @id @default(autoincrement())
  order      Order @relation(fields: [orderId], references: [id])
  orderId    Int
  addOn      AddOn @relation(fields: [addOnId], references: [id])
  addOnId    Int
  quantity   Int // Quantity of this add-on in the order
  totalPrice Float // Calculated based on quantity and price of add-on
}
